{
  "name": "TP HR Attrition",
  "dataColors": [
    "#8042CF",
    "#FF0082",
    "#4B4C6A",
    "#B08DE0",
    "#FF80C1",
    "#9A9BB5",
    "#D4D2CA",
    "#333333"
  ],
  "background": "#FFFFFF",
  "foreground": "#333333",
  "tableAccent": "#8042CF",
  "good": "#2F7D5B",
  "neutral": "#4B4C6A",
  "bad": "#FF0082",
  "minimum": "#FFE0F0",
  "center": "#FF80C1",
  "maximum": "#FF0082",
  "null": "#D4D2CA",
  "textClasses": {
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#333333" },
    "title":   { "fontSize": 14, "fontFace": "Segoe UI Semibold", "color": "#333333" },
    "header":  { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#4B4C6A" },
    "label":   { "fontSize": 11, "fontFace": "Segoe UI", "color": "#4B4C6A" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [ { "color": { "solid": { "color": "#F4F3F0" } }, "transparency": 0 } ]
      }
    },
    "*": {
      "*": {
        "title": [ {
          "show": true,
          "fontColor": { "solid": { "color": "#333333" } },
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 12
        } ],
        "background": [ {
          "show": true,
          "color": { "solid": { "color": "#FFFFFF" } },
          "transparency": 0
        } ],
        "border": [ {
          "show": true,
          "color": { "solid": { "color": "#D4D2CA" } },
          "radius": 6
        } ]
      }
    }
  }
}
